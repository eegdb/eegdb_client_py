{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EEGDB Client: GUI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1",
        "QT_QPA_PLATFORM": "xcb",
        "QT_LOGGING_RULES": "qt.qpa.*=false"
      }
    },
    {
      "name": "EEGDB Client: CLI health",
      "type": "debugpy",
      "request": "launch",
      "module": "eegdb_client",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "-v",
        "health"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "EEGDB Client: Current Python File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
